# J.A.R.V.I.S. Environment Configuration

# Server configuration
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=true

# Database
JARVIS_DATABASE_URL=sqlite:///./jarvis.db

# Live stream SSE ping interval (seconds)
JARVIS_SSE_PING_INTERVAL=15

# AI Provider (deterministic offline fallback is used if no key is provided)
JARVIS_AI_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=

